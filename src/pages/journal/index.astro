---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Pulls every English, non-draft entry automatically — this list needs
// no manual updates as new Markdown files are added.
const entries = (await getCollection('journal'))
  .filter((e) => e.data.lang === 'en' && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Journal" lang="en">
  <h1>Journal</h1>
  <ul>
    {entries.map((entry) => (
      <li>
        <a href={`/journal/${entry.id}`}>{entry.data.title}</a>
        <span> — {entry.data.date.toDateString()}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
