---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroRidge from '../assets/images/hero-ridge.jpg';
import climberRidge from '../assets/images/climber-ridge.jpg';
import olivierKeynote from '../assets/images/olivier-keynote.jpg';
import olivierClimbing from '../assets/images/olivier-climbing.jpg';
---

<BaseLayout
  title="Home"
  description="Higher Ground — Olivier Gil's mountain coaching practice, for objectives from your first 6,000m peak to no-oxygen 8,000ers, and for companies building that same readiness into their leadership."
  lang="en"
>
  <!-- Shared duotone filter (navy -> sky-bright), used on the pillar photos -->
  <svg width="0" height="0" style="position:absolute">
    <filter id="duotone" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="
        0.33 0.33 0.33 0 0
        0.33 0.33 0.33 0 0
        0.33 0.33 0.33 0 0
        0    0    0    1 0"/>
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.0275 0.6549"/>
        <feFuncG type="table" tableValues="0.1137 0.8039"/>
        <feFuncB type="table" tableValues="0.2471 0.9255"/>
      </feComponentTransfer>
    </filter>
  </svg>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-media">
      <Image src={heroRidge} alt="A rope team crossing a snow ridge above the clouds" class="hero-img" width={1920} quality={75} loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>
    <div class="wrap hero-in">
      <div class="eyebrow" style="color:var(--sky)">Mountain &amp; altitude readiness</div>
      <h1>Know you're ready. <em>Not just ambitious.</em></h1>
      <p class="hero-sub">
        Higher Ground — <strong>Olivier Gil's</strong> mountain coaching practice,
        for objectives from your first 6,000m peak to no-oxygen 8,000ers, and
        for companies building that same readiness into their leadership.
      </p>
      <div class="hero-cta">
        <a href="#pillars" class="btn btn-primary">What are you preparing for? ↓</a>
      </div>
    </div>
  </header>

  <!-- WHAT ARE YOU PREPARING FOR — Performance Lab / Ridgeline Keynote -->
  <section class="pillars" id="pillars">
    <div class="wrap">
      <div class="eyebrow">Where to start</div>
      <h2 class="serif">What are you preparing for?</h2>

      <div class="pillar-grid">
        <a href="/performance-lab" class="pillar-card">
          <div class="pillar-photo">
            <Image src={climberRidge} alt="A climber roped up, cramponing along a rocky summit ridge" width={800} quality={78} />
          </div>
          <div class="pillar-body">
            <span class="pillar-tag">Performance Lab</span>
            <span class="audience-tag">for athletes</span>
            <h3>You want to be ready for an ambitious mountain objective.</h3>
            <p>
              Higher Ground's <strong>Altitude Readiness System</strong> builds
              everything your objective depends on — engine, terrain skill,
              acclimatisation, efficiency, health — into one governed
              preparation, <strong>ultra-personalized</strong> to your
              mountain and your timeline. Defined by the stakes, not the
              sport: 8,000ers without supplemental oxygen, speed ascents and
              FKTs, technical objectives at altitude. The same system is live
              right now, preparing a no-oxygen ascent of Manaslu (8,163m) —
              proof it works before it's asked to prepare you.
            </p>
            <span class="pillar-link">Discover the Performance Lab →</span>

            <div class="pillar-subnote">
              <span class="subnote-label">Run an expedition agency?</span>
              <p>
                Your clients have booked their expedition — you want them to
                arrive genuinely ready. That same readiness, built into the
                trips you already sell. Occasionally open to the right
                partnership. <span class="subnote-link">Get in touch →</span>
              </p>
            </div>
          </div>
        </a>

        <a href="/leadership" class="pillar-card">
          <div class="pillar-photo">
            <Image src={olivierKeynote} alt="Olivier delivering a keynote on stage" width={800} quality={78} />
          </div>
          <div class="pillar-body">
            <span class="pillar-tag">The Ridgeline Keynote</span>
            <span class="audience-tag">for companies</span>
            <h3>You want your people ready when it counts.</h3>
            <p>
              The Ridgeline is a keynote for companies and leadership teams,
              drawn from real decisions above 6,000 metres. High-altitude
              objectives strip leadership down to its essentials: you prepare
              properly or you don't summit, you read the conditions honestly
              or you get hurt, you make the hard call — to push or to turn —
              when it matters, not after. The same discipline that decides an
              expedition decides how a team performs under real pressure — <strong>knowing what matters, adapting when reality changes,
              and having the composure to own the decision.</strong> Not
              motivation. Not metaphor for its own sake. The same readiness,
              applied where the stakes are different but no less real.
            </p>
            <span class="pillar-link">Discover The Ridgeline Keynote →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- THE ALTITUDE READINESS SYSTEM -->
  <section class="ars">
    <svg class="contours" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="#7FB0D9" stroke-width="1">
        <path d="M-50,330 C260,280 400,210 600,226 C800,242 920,180 1070,188 C1175,193 1240,180 1260,184" opacity=".5"/>
        <path d="M-50,275 C280,220 420,150 620,164 C820,178 940,116 1078,122 C1180,126 1245,116 1260,120" opacity=".55"/>
      </g>
    </svg>
    <div class="wrap ars-in">
      <div class="eyebrow" style="color:var(--sky)">The Altitude Readiness System</div>
      <div class="ars-grid">
        <div class="ars-lead">Higher Ground developed the <em>Altitude Readiness System</em> — and proves it against objectives that leave no room for guesswork.</div>
        <div>
          <p class="ars-body">The ARS integrates everything readiness depends on — engine, terrain skills, acclimatisation, pre-acclimatisation, efficiency, health — into one governed preparation. It's built on the reference science of mountain performance and operated with specialist partners.</p>
          <p class="ars-body">Right now, the system is <strong>live at the highest level</strong>: preparing an athlete for a no-oxygen ascent of Manaslu (8,163m), the first of fourteen eight-thousanders without supplemental oxygen. <strong>The same system that readies an athlete for 8,000m without oxygen is what prepares you for your objective</strong> — your first 6,000m peak, or your hardest yet.</p>
          <a class="ars-cta" href="/method">See how the system works →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AMA DABLAM 27 -->
  <section class="expedition">
    <svg class="contours" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="#7FB0D9" stroke-width="1">
        <path d="M-50,236 C320,180 460,116 640,126 C820,136 940,82 1070,86 C1175,90 1240,80 1260,82" opacity=".38"/>
      </g>
    </svg>
    <div class="wrap">
      <div class="eyebrow" style="color:var(--sky)">The next objective — 2027</div>
      <h2 class="serif">Not a summit story. <em>A team story.</em></h2>
      <p class="expedition-body">
        Ama Dablam, 6,812m, Nepal — Olivier's next objective. But the story
        worth telling isn't the ascent. It's how a team gets built: the first
        calls, the training weekends, the doubts, the progress — documented
        from day one, because how ordinary people with jobs and families
        accomplish extraordinary things is worth showing honestly, not just
        the summit day.
      </p>
      <a href="/journal" class="btn btn-primary">Follow the journal →</a>
    </div>
  </section>

  <!-- BEHIND HIGHER GROUND -->
  <section class="founder">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <div class="founder-photo-inner">
          <Image src={olivierClimbing} alt="Olivier climbing on a granite slab, roped up in the mountains" width={700} quality={80} />
        </div>
      </div>
      <div class="founder-text">
        <div class="eyebrow">Behind Higher Ground</div>
        <h2 class="serif">Two demanding worlds.<br><em>One discipline.</em></h2>
        <p>
          Higher Ground is built by <strong>Olivier Gil</strong> — for over
          fifteen years both a senior executive in high-stakes environments
          and a serious alpinist, from technical ascents across the Pyrenees,
          the Alps and the Pamir to Ama Dablam, Nepal, ahead in 2027.
        </p>
        <p>
          The lesson from both worlds is the same: <strong>success isn't doing
          more — it's preparing better, and knowing honestly when you're
          ready.</strong> UESCA-certified coach, grounded in the reference
          literature of alpinism.
        </p>
        <a href="/about" class="btn-quiet">More about Olivier →</a>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="cta">
    <div class="cta-in">
      <div class="eyebrow" style="color:var(--sky)">Start the conversation</div>
      <h2 class="serif">Let's talk about what you're preparing for.</h2>
      <a href="/enquire" class="btn btn-primary">Let's talk</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    min-height: 620px; display: flex; align-items: center;
    background: var(--navy-deep);
  }
  .hero-media { position: absolute; inset: 0; z-index: 1; }
  .hero-media .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(3,13,30,.90) 0%, rgba(3,13,30,.68) 46%, rgba(7,29,63,.40) 100%);
  }
  .hero-in { position: relative; z-index: 2; padding: 96px 32px; width: 100%; }
  .hero h1 {
    font-family: 'IBM Plex Sans', sans-serif; font-weight: 600;
    color: #fff; font-size: clamp(38px, 6.4vw, 72px);
    line-height: 1.08; letter-spacing: -.02em; margin: 20px 0 26px; max-width: 15ch;
  }
  .hero h1 em { font-style: normal; color: var(--sky-bright); }
  .hero-sub { font-size: clamp(17px, 1.9vw, 20px); color: #C8D6E5; font-weight: 300; max-width: 54ch; line-height: 1.65; }
  .hero-cta { margin-top: 36px; }

  /* PILLARS */
  .pillars { padding: 96px 0; background: var(--ice); }
  .pillars h2 { font-size: clamp(28px, 3.9vw, 40px); color: var(--navy); margin: 12px 0 44px; }
  .pillar-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; align-items: stretch; }
  .pillar-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--line);
    border-radius: 18px; text-decoration: none; overflow: hidden;
    transition: transform .2s, box-shadow .2s;
  }
  .pillar-card:hover { transform: translateY(-3px); box-shadow: 0 18px 48px -20px rgba(7,29,63,.28); }

  /* Duotone photo treatment — tones the image into the site's own navy/sky
     palette via the shared SVG filter, instead of a full-color photo with
     an overlay fighting it. */
  .pillar-photo { aspect-ratio: 16 / 10; position: relative; overflow: hidden; background: var(--navy-mid); }
  .pillar-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: url(#duotone); }

  .pillar-body { padding: 32px 40px 42px; display: flex; flex-direction: column; flex: 1; }
  .pillar-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 15px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--tag-blue);
  }
  .audience-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 15px; font-weight: 500; letter-spacing: .08em;
    text-transform: uppercase; color: var(--steel); margin-left: 10px;
  }
  .pillar-card h3 { font-size: 24px; font-weight: 600; color: var(--navy); line-height: 1.32; margin: 14px 0 16px; }
  .pillar-card p { font-size: 17px; color: var(--text-mid); line-height: 1.68; margin-bottom: 20px; }
  .pillar-card p strong { color: var(--navy); font-weight: 600; }
  .pillar-link { font-size: 15.5px; font-weight: 600; color: var(--navy); }
  .pillar-subnote {
    margin-top: auto; padding-top: 22px; margin-top: 26px;
    border-top: 1px solid var(--line);
  }
  .subnote-label {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--sky); font-weight: 500; display: block; margin-bottom: 8px;
  }
  .pillar-subnote p { font-size: 14.5px; color: var(--text-mid); line-height: 1.55; margin-bottom: 0; }
  .subnote-link { color: var(--navy); font-weight: 600; white-space: nowrap; }
  @media (max-width: 860px) { .pillar-grid { grid-template-columns: 1fr; } }

  /* ALTITUDE READINESS SYSTEM */
  .ars { background: var(--navy); color: #fff; padding: 84px 0; position: relative; overflow: hidden; }
  .ars .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .3; }
  .ars-in { position: relative; z-index: 2; }
  .ars-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: center; margin-top: 24px; }
  .ars-lead { font-size: clamp(25px, 3.2vw, 35px); font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .ars-lead em { font-style: normal; color: var(--sky-bright); }
  .ars-body { color: #B8CBDE; font-size: 16.5px; line-height: 1.65; }
  .ars-body strong { color: #fff; font-weight: 600; }
  .ars-body + .ars-body { margin-top: 14px; }
  .ars-cta {
    display: inline-block; margin-top: 22px; font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--sky);
    border: 1px solid rgba(127,176,217,.35); border-radius: 100px; padding: 8px 16px; transition: all .2s;
  }
  .ars-cta:hover { background: var(--sky); color: var(--navy-deep); }
  @media (max-width: 800px) { .ars-grid { grid-template-columns: 1fr; gap: 26px; } }

  /* AMA DABLAM 27 */
  .expedition { background: var(--navy-deep); color: #fff; padding: 92px 0; position: relative; overflow: hidden; }
  .expedition .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .22; }
  .expedition .wrap { position: relative; z-index: 2; }
  .expedition h2 { font-size: clamp(28px, 4vw, 42px); margin: 12px 0 22px; max-width: 18ch; }
  .expedition h2 em { font-style: normal; color: var(--sky-bright); }
  .expedition-body { font-size: 17px; color: #C8D6E5; font-weight: 300; line-height: 1.7; max-width: 62ch; margin-bottom: 30px; }

  /* BEHIND HIGHER GROUND */
  .founder { background: var(--paper); padding: 92px 0; border-top: 1px solid var(--line); }
  .founder-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 52px; align-items: center; }
  .founder-photo-inner { aspect-ratio: 4 / 5; border-radius: 16px; position: relative; overflow: hidden; }
  .founder-photo-inner :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .founder-photo-inner::after {
    content: ""; position: absolute; inset: 0;
    background: var(--navy); opacity: .16; mix-blend-mode: multiply; pointer-events: none;
  }
  .founder-text h2 { font-size: clamp(27px, 3.7vw, 37px); color: var(--navy); margin: 12px 0 22px; }
  .founder-text p { color: var(--text-mid); font-size: 17.5px; line-height: 1.72; margin-bottom: 18px; }
  .founder-text p strong { color: var(--navy); font-weight: 600; }
  @media (max-width: 780px) { .founder-grid { grid-template-columns: 1fr; gap: 32px; } .founder-photo-inner { max-width: 320px; margin: 0 auto; } }

  /* CTA */
  .cta { background: var(--navy-deep); color: #fff; padding: 92px 0; }
  .cta-in { text-align: center; max-width: 560px; margin: 0 auto; padding: 0 32px; }
  .cta h2 { font-size: clamp(28px, 4vw, 40px); margin: 14px 0 30px; }
</style>
