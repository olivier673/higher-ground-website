---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroRidge from '../assets/images/hero-ridge.jpg';
---

<BaseLayout
  title="Home"
  description="Higher Ground — Olivier Gil's mountain coaching practice, for athletes preparing serious altitude goals and companies building readiness into their leadership."
  lang="en"
>
  <!-- HERO -->
  <header class="hero">
    <div class="hero-media">
      <Image src={heroRidge} alt="A rope team crossing a snow ridge above the clouds" class="hero-img" width={1920} quality={75} loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>
    <div class="wrap hero-in">
      <div class="eyebrow" style="color:var(--sky)">Mountain &amp; altitude readiness</div>
      <h1>Know you're ready. <em>Not just ambitious.</em></h1>
      <p class="hero-sub">
        Higher Ground — <strong>Olivier Gil's</strong> mountain coaching practice, for
        athletes preparing serious altitude goals and companies building readiness
        into their leadership.
      </p>
      <div class="hero-cta">
        <a href="#pillars" class="btn btn-primary">What are you preparing for? ↓</a>
        <a href="/enquire" class="btn btn-ghost">Book a readiness call</a>
      </div>
      <p class="hero-quiet">
        Leading a team instead? <a href="/leadership" class="btn-quiet" style="color:var(--sky-bright);border-color:rgba(167,205,236,.4)">→ The Ridgeline</a>
      </p>
    </div>
  </header>

  <!-- THE PROBLEM, IN THE VISITOR'S OWN TERMS -->
  <section class="problem">
    <div class="narrow problem-in">
      <div class="eyebrow">The gap nobody trains for</div>
      <h2 class="serif">Ambition is not the same as readiness.</h2>
      <p>
        Most people preparing for something hard focus entirely on effort — more
        training, more hours, more will. But on the objectives that actually
        matter, the people who succeed aren't always the fittest or the most
        driven. They're the ones who arrive <strong>genuinely ready</strong> —
        for the specific demands of their mountain, or the specific pressure of
        their moment at work.
      </p>
      <p class="kicker">Effort is one input. Readiness is the outcome.</p>
    </div>
  </section>

  <!-- PILLARS — doubles as the router; Leadership given primary billing -->
  <section class="pillars" id="pillars">
    <div class="wrap">
      <div class="eyebrow">Where to start</div>
      <h2 class="serif">What are you preparing for?</h2>

      <a href="/leadership" class="pillar-feature">
        <span class="pillar-tag">Leadership</span>
        <h3>A team to strengthen</h3>
        <p>
          The same discipline that prepares athletes for the mountain, translated
          for leaders and teams who face their own high-stakes moments. The
          Ridgeline — a keynote built on it.
        </p>
        <span class="pillar-link">Discover Leadership →</span>
      </a>

      <div class="pillar-row">
        <a href="/performance-lab" class="pillar-card">
          <span class="pillar-tag">Performance Lab</span>
          <h3>A mountain objective</h3>
          <p>
            Applied mountain performance for a limited number of athletes —
            currently Simon Niklaus and Dina, preparing for genuinely serious
            objectives. This isn't a program you apply to; it's proof the method
            works.
          </p>
          <span class="pillar-link">See the work →</span>
        </a>

        <a href="/agencies" class="pillar-card pillar-quiet">
          <span class="pillar-tag">Agencies</span>
          <h3>Clients to prepare</h3>
          <p>Run an expedition agency? Occasionally open to the right partnership.</p>
          <span class="pillar-link">Get in touch →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PROOF / REASSURANCE BAND -->
  <section class="proofband">
    <div class="wrap">
      <div class="eyebrow" style="color:var(--sky)">Why this, not just another coach or speaker</div>
      <h2 class="serif" style="color:#fff">Fifteen years earning both sides of this.</h2>
      <div class="proof-grid">
        <div class="proof-item">
          <h4>UESCA-Certified Coach</h4>
          <p>Trained and certified in altitude and ultra-endurance coaching methodology.</p>
        </div>
        <div class="proof-item">
          <h4>15+ Years, Executive</h4>
          <p>Senior leadership in cybersecurity, alongside every year on the mountain.</p>
        </div>
        <div class="proof-item">
          <h4>The Mountain Record</h4>
          <p>Mont Blanc solo. Kyrgyzstan. The Vignemale. Ama Dablam, 2027.</p>
        </div>
        <div class="proof-item">
          <h4>Manaslu, No O₂</h4>
          <p>Simon Niklaus's flagship ascent — Higher Ground's proof of concept, live.</p>
        </div>
        <a href="/journal" class="proof-item proof-link">
          <h4>The Ama Dablam Journal</h4>
          <p>Building a team, documented from the first call. → Follow along</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FOUNDER BRIDGE -->
  <section class="founder">
    <div class="wrap founder-in">
      <div class="eyebrow">Behind Higher Ground</div>
      <h2 class="serif">Two demanding worlds. One discipline.</h2>
      <p>
        Every method here is tested first on Olivier's own preparation — on the
        mountain, and in the boardroom — before it's ever offered to someone else.
      </p>
      <a href="/about" class="btn-quiet">More about Olivier →</a>
    </div>
  </section>

  <!-- CLOSING — TWO DOORS -->
  <section class="cta">
    <div class="cta-in">
      <div class="eyebrow" style="color:var(--sky)">Start with the verdict</div>
      <h2 class="serif">Let's talk about what you're preparing for.</h2>
      <div class="cta-doors">
        <a href="/enquire" class="btn btn-primary">Book a readiness call</a>
        <a href="/leadership" class="btn btn-ghost">Enquire about The Ridgeline</a>
      </div>
      <div class="cta-labels">
        <span>Mountain objectives</span>
        <span>Teams &amp; leaders</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    min-height: 640px; display: flex; align-items: center;
    background: var(--navy-deep);
  }
  .hero-media { position: absolute; inset: 0; z-index: 1; }
  .hero-media :global(.hero-img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(3,13,30,.90) 0%, rgba(3,13,30,.68) 46%, rgba(7,29,63,.40) 100%);
  }
  .hero-in { position: relative; z-index: 2; padding: 96px 32px; width: 100%; }
  .hero h1 {
    font-family: 'IBM Plex Sans', sans-serif; font-weight: 600;
    color: #fff; font-size: clamp(38px, 6.4vw, 72px);
    line-height: 1.08; letter-spacing: -.02em; margin: 20px 0 26px; max-width: 15ch;
  }
  .hero h1 em { font-style: normal; color: var(--sky-bright); }
  .hero-sub { font-size: clamp(16px, 1.8vw, 19px); color: #C8D6E5; font-weight: 300; max-width: 52ch; line-height: 1.6; }
  .hero-cta { display: flex; gap: 14px; margin-top: 40px; flex-wrap: wrap; }
  .hero-quiet { margin-top: 22px; font-size: 14px; color: var(--steel-lt); }

  /* PROBLEM */
  .problem { padding: 96px 0; background: var(--paper); }
  .problem-in { text-align: left; }
  .problem h2 { font-size: clamp(27px, 3.8vw, 38px); color: var(--navy); line-height: 1.18; margin: 14px 0 22px; }
  .problem p { font-size: 17.5px; color: var(--text-mid); line-height: 1.75; }
  .kicker {
    font-weight: 500; font-size: clamp(18px, 2.2vw, 21px); color: var(--navy);
    border-left: 2px solid var(--sky); padding-left: 20px; margin: 26px 0 0 !important;
  }

  /* PILLARS */
  .pillars { padding: 92px 0; background: var(--ice); }
  .pillars h2 { font-size: clamp(27px, 3.8vw, 38px); color: var(--navy); margin: 12px 0 40px; }
  .pillar-feature, .pillar-card {
    display: block; background: #fff; border: 1px solid var(--line);
    border-radius: 16px; text-decoration: none; transition: transform .2s, box-shadow .2s;
  }
  .pillar-feature:hover, .pillar-card:hover { transform: translateY(-3px); box-shadow: 0 16px 44px -20px rgba(7,29,63,.28); }
  .pillar-feature { padding: 40px 40px 36px; margin-bottom: 18px; border-color: var(--sky); border-width: 1.5px; }
  .pillar-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .pillar-card { padding: 30px 32px; }
  .pillar-quiet { background: transparent; box-shadow: none; }
  .pillar-quiet:hover { box-shadow: none; transform: none; background: #fff; }
  .pillar-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--steel); font-weight: 500;
  }
  .pillar-feature h3 { font-size: 26px; font-weight: 600; color: var(--navy); margin: 10px 0 12px; }
  .pillar-card h3 { font-size: 19px; font-weight: 600; color: var(--navy); margin: 8px 0 10px; }
  .pillar-feature p { font-size: 16px; color: var(--text-mid); line-height: 1.6; max-width: 62ch; margin-bottom: 18px; }
  .pillar-card p { font-size: 14.5px; color: var(--text-mid); line-height: 1.55; margin-bottom: 14px; }
  .pillar-link { font-size: 14px; font-weight: 500; color: var(--navy); }
  @media (max-width: 760px) { .pillar-row { grid-template-columns: 1fr; } }

  /* PROOF BAND */
  .proofband { background: var(--navy-deep); padding: 88px 0; }
  .proofband h2 { font-size: clamp(26px, 3.6vw, 36px); margin: 12px 0 44px; }
  .proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 2px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.08); }
  .proof-item { background: var(--navy-mid); padding: 26px 24px; display: block; text-decoration: none; }
  .proof-item h4 { font-size: 15.5px; font-weight: 600; color: #fff; margin-bottom: 8px; }
  .proof-item p { font-size: 13.5px; color: #A9BCD1; line-height: 1.5; }
  .proof-link:hover { background: var(--navy); }
  .proof-link p { color: var(--sky-bright); }

  /* FOUNDER */
  .founder { background: var(--paper); padding: 84px 0; border-top: 1px solid var(--line); }
  .founder-in { max-width: 620px; }
  .founder h2 { font-size: clamp(25px, 3.4vw, 33px); color: var(--navy); margin: 12px 0 18px; }
  .founder p { color: var(--text-mid); font-size: 16px; line-height: 1.65; margin-bottom: 20px; }

  /* CTA */
  .cta { background: var(--navy-deep); color: #fff; padding: 90px 0; }
  .cta-in { text-align: center; max-width: 620px; margin: 0 auto; padding: 0 32px; }
  .cta h2 { font-size: clamp(28px, 4vw, 40px); margin: 14px 0 30px; }
  .cta-doors { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta-labels {
    display: flex; gap: 40px; justify-content: center; margin-top: 16px;
    font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: .06em;
    color: var(--steel-lt); text-transform: uppercase;
  }
</style>
