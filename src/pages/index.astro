---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroRidge from '../assets/images/hero-ridge.jpg';
---

<BaseLayout
  title="Home"
  description="Higher Ground — Olivier Gil's mountain coaching practice, for athletes preparing serious altitude goals and companies building readiness into their leadership."
  lang="en"
>
  <!-- HERO -->
  <header class="hero">
    <div class="hero-media">
      <Image src={heroRidge} alt="A rope team crossing a snow ridge above the clouds" class="hero-img" width={1920} quality={75} loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>
    <div class="wrap hero-in">
      <div class="eyebrow" style="color:var(--sky)">Mountain &amp; altitude readiness</div>
      <h1>Know you're ready. <em>Not just ambitious.</em></h1>
      <p class="hero-sub">
        Higher Ground — <strong>Olivier Gil's</strong> mountain coaching practice, for
        athletes preparing serious altitude goals and companies building readiness
        into their leadership.
      </p>
      <div class="hero-cta">
        <a href="/enquire" class="btn btn-primary">Let's talk</a>
      </div>
      <p class="hero-quiet">
        Leading a team instead? <a href="/leadership" class="btn-quiet" style="color:var(--sky-bright);border-color:rgba(167,205,236,.4)">→ The Ridgeline</a>
      </p>
    </div>
  </header>

  <!-- THE PROBLEM, BY AUDIENCE -->
  <section class="problem">
    <div class="wrap">
      <div class="eyebrow">The problem, by audience</div>
      <h2 class="serif">What's actually missing.</h2>

      <div class="problem-grid">
        <div class="problem-item">
          <span class="problem-label">Athletes</span>
          <p>
            A generic training plan doesn't know your objective's altitude
            profile or your own acclimatization response. Higher Ground builds <strong>altitude readiness</strong> around you specifically — <strong>ultra-personalized</strong> to your mountain, your
            physiology and your timeline, not a template stretched to fit.
          </p>
        </div>
        <div class="problem-item">
          <span class="problem-label">Companies &amp; leaders</span>
          <p>
            Most leadership development runs on motivation and frameworks,
            tested by nothing more consequential than a workshop. The Ridgeline
            brings lessons earned where the cost of getting it wrong is real — <strong>structure over willpower</strong>, and the judgment to
            turn back before it's too late.
          </p>
        </div>
        <div class="problem-item">
          <span class="problem-label">Expedition agencies</span>
          <p>
            Under-prepared clients cost you: turnbacks, incidents, guide time,
            reviews that hurt future bookings. Higher Ground is a readiness
            partner working before departure — not another gear list.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS — equal weight, Performance Lab / Leadership / Agencies -->
  <section class="pillars" id="pillars">
    <div class="wrap">
      <div class="eyebrow">Where to start</div>
      <h2 class="serif">What are you preparing for?</h2>

      <div class="pillar-grid">
        <a href="/performance-lab" class="pillar-card">
          <span class="pillar-tag">Performance Lab</span>
          <h3>You want to be ready for an ambitious mountain objective.</h3>
          <p>
            Defined by the stakes, not the sport — 8,000ers without
            supplemental oxygen, speed ascents and FKTs, technical objectives
            at altitude. If the margin is thin and the consequences are real,
            this is where readiness becomes a decision, not a feeling.
          </p>
          <span class="pillar-link">See the work →</span>
        </a>

        <a href="/leadership" class="pillar-card">
          <span class="pillar-tag">Leadership</span>
          <h3>You want your team ready when it actually matters.</h3>
          <p>
            The Ridgeline: a 45-minute keynote built on the conversation
            climbers have in a mess tent the night before a summit attempt,
            where every doubt gets named before anyone commits. Teams leave
            with a shared language for exactly that moment — and use it long
            after the keynote ends.
          </p>
          <span class="pillar-link">Discover Leadership →</span>
        </a>

        <a href="/agencies" class="pillar-card">
          <span class="pillar-tag">Agencies</span>
          <h3>You run an expedition agency and want clients who arrive ready.</h3>
          <p>
            The agency brings the mountain. Higher Ground prepares the
            mountaineer. Occasionally open to the right partnership —
            readiness built into the trips you already sell.
          </p>
          <span class="pillar-link">Get in touch →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="founder">
    <div class="wrap founder-in">
      <div class="eyebrow">Behind Higher Ground</div>
      <h2 class="serif">Two demanding worlds. One discipline.</h2>
      <p>
        Higher Ground is built by <strong>Olivier Gil</strong> — a senior
        executive today in cybersecurity, with a career spanning other
        industries before that, and an alpinist with ascents across the
        Pyrenees, the Alps and the Pamir — currently preparing Ama Dablam,
        Nepal, in 2027. UESCA-certified as a coach. Every method here is
        tested on his own preparation first — currently proven live with
        Simon Niklaus's no-oxygen ascent of Manaslu.
      </p>
      <a href="/about" class="btn-quiet">More about Olivier →</a>
    </div>
  </section>

  <!-- CLOSING — ONE ASK, MATCHING THE HERO -->
  <section class="cta">
    <div class="cta-in">
      <div class="eyebrow" style="color:var(--sky)">Start the conversation</div>
      <h2 class="serif">Let's talk about what you're preparing for.</h2>
      <a href="/enquire" class="btn btn-primary">Let's talk</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    min-height: 620px; display: flex; align-items: center;
    background: var(--navy-deep);
  }
  .hero-media { position: absolute; inset: 0; z-index: 1; }
  .hero-media .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(3,13,30,.90) 0%, rgba(3,13,30,.68) 46%, rgba(7,29,63,.40) 100%);
  }
  .hero-in { position: relative; z-index: 2; padding: 96px 32px; width: 100%; }
  .hero h1 {
    font-family: 'IBM Plex Sans', sans-serif; font-weight: 600;
    color: #fff; font-size: clamp(38px, 6.4vw, 72px);
    line-height: 1.08; letter-spacing: -.02em; margin: 20px 0 26px; max-width: 15ch;
  }
  .hero h1 em { font-style: normal; color: var(--sky-bright); }
  .hero-sub { font-size: clamp(16px, 1.8vw, 19px); color: #C8D6E5; font-weight: 300; max-width: 52ch; line-height: 1.6; }
  .hero-cta { margin-top: 36px; }
  .hero-quiet { margin-top: 22px; font-size: 14px; color: var(--steel-lt); }

  /* PROBLEM — three audiences */
  .problem { padding: 96px 0; background: var(--paper); }
  .problem h2 { font-size: clamp(27px, 3.8vw, 38px); color: var(--navy); line-height: 1.18; margin: 14px 0 44px; }
  .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .problem-label {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--sky); font-weight: 500; display: block; margin-bottom: 14px;
    border-bottom: 1px solid var(--line); padding-bottom: 12px;
  }
  .problem-item p { font-size: 15.5px; color: var(--text-mid); line-height: 1.65; }
  .problem-item p strong { color: var(--navy); font-weight: 600; }
  @media (max-width: 860px) { .problem-grid { grid-template-columns: 1fr; gap: 34px; } }

  /* PILLARS — equal weight */
  .pillars { padding: 92px 0; background: var(--ice); }
  .pillars h2 { font-size: clamp(27px, 3.8vw, 38px); color: var(--navy); margin: 12px 0 40px; }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .pillar-card {
    display: block; background: #fff; border: 1px solid var(--line);
    border-radius: 16px; text-decoration: none; padding: 32px 30px;
    transition: transform .2s, box-shadow .2s;
  }
  .pillar-card:hover { transform: translateY(-3px); box-shadow: 0 16px 44px -20px rgba(7,29,63,.28); }
  .pillar-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--steel); font-weight: 500;
  }
  .pillar-card h3 { font-size: 19.5px; font-weight: 600; color: var(--navy); line-height: 1.3; margin: 12px 0 12px; }
  .pillar-card p { font-size: 14.5px; color: var(--text-mid); line-height: 1.6; margin-bottom: 16px; }
  .pillar-link { font-size: 14px; font-weight: 500; color: var(--navy); }
  @media (max-width: 900px) { .pillar-grid { grid-template-columns: 1fr; } }

  /* FOUNDER / ABOUT TEASER */
  .founder { background: var(--paper); padding: 88px 0; border-top: 1px solid var(--line); }
  .founder-in { max-width: 680px; }
  .founder h2 { font-size: clamp(26px, 3.6vw, 36px); color: var(--navy); margin: 12px 0 20px; }
  .founder p { color: var(--text-mid); font-size: 16.5px; line-height: 1.7; margin-bottom: 22px; }
  .founder p strong { color: var(--navy); font-weight: 600; }

  /* CTA */
  .cta { background: var(--navy-deep); color: #fff; padding: 90px 0; }
  .cta-in { text-align: center; max-width: 560px; margin: 0 auto; padding: 0 32px; }
  .cta h2 { font-size: clamp(28px, 4vw, 40px); margin: 14px 0 30px; }
</style>
