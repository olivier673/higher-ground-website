---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroRidge from '../assets/images/hero-ridge.jpg';
import olivierClimbing from '../assets/images/olivier-climbing.jpg';
import olivierKeynote from '../assets/images/olivier-keynote.jpg';
---

<BaseLayout
  title="Home"
  description="Higher Ground — Olivier Gil's mountain coaching practice, for athletes preparing serious altitude goals and companies building readiness into their leadership."
  lang="en"
>
  <!-- HERO -->
  <header class="hero">
    <div class="hero-media">
      <Image src={heroRidge} alt="A rope team crossing a snow ridge above the clouds" class="hero-img" width={1920} quality={75} loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>
    <div class="wrap hero-in">
      <div class="eyebrow" style="color:var(--sky)">Mountain &amp; altitude readiness</div>
      <h1>Know you're ready. <em>Not just ambitious.</em></h1>
      <p class="hero-sub">
        Higher Ground — <strong>Olivier Gil's</strong> mountain coaching practice, for
        athletes preparing serious altitude goals and companies building readiness
        into their leadership.
      </p>
      <div class="hero-cta">
        <a href="/enquire" class="btn btn-primary">Let's talk</a>
      </div>
    </div>
  </header>

  <!-- WHAT WE DO — problem + solution merged, two ways in -->
  <section class="pillars" id="pillars">
    <div class="wrap">
      <div class="eyebrow">Where to start</div>
      <h2 class="serif">What are you preparing for?</h2>

      <div class="pillar-grid">
        <a href="/performance-lab" class="pillar-card">
          <div class="pillar-photo">
            <Image src={olivierClimbing} alt="Olivier climbing on a granite slab, roped up in the mountains" width={800} quality={78} />
          </div>
          <div class="pillar-body">
            <span class="pillar-tag">Performance Lab</span>
            <h3>You want to be ready for an ambitious mountain objective.</h3>
            <p>
              A generic training plan doesn't know your objective's altitude
              profile or your own acclimatization response. Higher Ground builds <strong>altitude readiness</strong> around you specifically — <strong>ultra-personalized</strong> to your mountain, your
              physiology and your timeline. Defined by the stakes, not the
              sport: 8,000ers without supplemental oxygen, speed ascents and
              FKTs, technical objectives at altitude. If the margin is thin and
              the consequences are real, this is where readiness becomes a
              decision, not a feeling.
            </p>
            <span class="pillar-link">Discover the Performance Lab →</span>

            <div class="pillar-subnote">
              <span class="subnote-label">Run an expedition agency?</span>
              <p>
                The agency brings the mountain. Higher Ground prepares the
                mountaineer — occasionally open to the right partnership. <span class="subnote-link">Get in touch →</span>
              </p>
            </div>
          </div>
        </a>

        <a href="/leadership" class="pillar-card">
          <div class="pillar-photo">
            <Image src={olivierKeynote} alt="Olivier delivering a keynote on stage" width={800} quality={78} />
          </div>
          <div class="pillar-body">
            <span class="pillar-tag">Leadership</span>
            <h3>You want your team ready when it actually matters.</h3>
            <p>
              Most leadership development runs on motivation and frameworks,
              tested by nothing more consequential than a workshop. The
              Ridgeline brings lessons earned where the cost of getting it
              wrong is real — <strong>structure over willpower</strong>, and
              the judgment to turn back before it's too late. A 45-minute
              keynote built on the conversation climbers have in a mess tent
              the night before a summit attempt, where every doubt gets named
              before anyone commits. Teams leave with a shared language for
              exactly that moment — and use it long after the keynote ends.
            </p>
            <span class="pillar-link">Discover Leadership →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- BEHIND HIGHER GROUND -->
  <section class="founder">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <div class="photo-slot">
          PHOTO SLOT — portrait of Olivier, mountain or executive context
        </div>
      </div>
      <div class="founder-text">
        <div class="eyebrow">Behind Higher Ground</div>
        <h2 class="serif">Two demanding worlds. One discipline.</h2>
        <p>
          Higher Ground is built by <strong>Olivier Gil</strong>. As a senior
          executive, he leads teams and projects internationally — today in
          cybersecurity, with a career spanning other industries before that.
          As an alpinist, the mountains have been his teacher: ascents across
          the Pyrenees, the Alps and the Pamir, and now Ama Dablam, Nepal, in
          2027.
        </p>
        <p>
          UESCA-certified as a coach, every method here is tested on his own
          preparation first — currently proven live with Simon Niklaus's
          no-oxygen ascent of Manaslu.
        </p>
        <a href="/about" class="btn-quiet">More about Olivier →</a>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="cta">
    <div class="cta-in">
      <div class="eyebrow" style="color:var(--sky)">Start the conversation</div>
      <h2 class="serif">Let's talk about what you're preparing for.</h2>
      <a href="/enquire" class="btn btn-primary">Let's talk</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative; overflow: hidden;
    min-height: 620px; display: flex; align-items: center;
    background: var(--navy-deep);
  }
  .hero-media { position: absolute; inset: 0; z-index: 1; }
  .hero-media .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(3,13,30,.90) 0%, rgba(3,13,30,.68) 46%, rgba(7,29,63,.40) 100%);
  }
  .hero-in { position: relative; z-index: 2; padding: 96px 32px; width: 100%; }
  .hero h1 {
    font-family: 'IBM Plex Sans', sans-serif; font-weight: 600;
    color: #fff; font-size: clamp(38px, 6.4vw, 72px);
    line-height: 1.08; letter-spacing: -.02em; margin: 20px 0 26px; max-width: 15ch;
  }
  .hero h1 em { font-style: normal; color: var(--sky-bright); }
  .hero-sub { font-size: clamp(17px, 1.9vw, 20px); color: #C8D6E5; font-weight: 300; max-width: 52ch; line-height: 1.65; }
  .hero-cta { margin-top: 36px; }

  /* PILLARS — two wide cards, photo band + merged problem/solution text */
  .pillars { padding: 96px 0; background: var(--ice); }
  .pillars h2 { font-size: clamp(28px, 3.9vw, 40px); color: var(--navy); margin: 12px 0 44px; }
  .pillar-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; align-items: stretch; }
  .pillar-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--line);
    border-radius: 18px; text-decoration: none; overflow: hidden;
    transition: transform .2s, box-shadow .2s;
  }
  .pillar-card:hover { transform: translateY(-3px); box-shadow: 0 18px 48px -20px rgba(7,29,63,.28); }

  /* Photo band — same navy-tint treatment as the hero, at reduced strength
     so the person underneath stays clearly visible. */
  .pillar-photo { aspect-ratio: 16 / 10; position: relative; overflow: hidden; }
  .pillar-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.9); }
  .pillar-photo::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(150deg, rgba(7,29,63,.38) 0%, rgba(3,13,30,.22) 55%, rgba(7,29,63,.32) 100%);
    mix-blend-mode: multiply; pointer-events: none;
  }

  .pillar-body { padding: 32px 40px 42px; display: flex; flex-direction: column; flex: 1; }
  .pillar-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--steel); font-weight: 500;
  }
  .pillar-card h3 { font-size: 24px; font-weight: 600; color: var(--navy); line-height: 1.32; margin: 14px 0 16px; }
  .pillar-card p { font-size: 17px; color: var(--text-mid); line-height: 1.68; margin-bottom: 20px; }
  .pillar-card p strong { color: var(--navy); font-weight: 600; }
  .pillar-link { font-size: 15.5px; font-weight: 600; color: var(--navy); }
  .pillar-subnote {
    margin-top: auto; padding-top: 22px; margin-top: 26px;
    border-top: 1px solid var(--line);
  }
  .subnote-label {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--sky); font-weight: 500; display: block; margin-bottom: 8px;
  }
  .pillar-subnote p { font-size: 14.5px; color: var(--text-mid); line-height: 1.55; margin-bottom: 0; }
  .subnote-link { color: var(--navy); font-weight: 600; white-space: nowrap; }
  @media (max-width: 860px) { .pillar-grid { grid-template-columns: 1fr; } }

  /* BEHIND HIGHER GROUND */
  .founder { background: var(--paper); padding: 92px 0; border-top: 1px solid var(--line); }
  .founder-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 52px; align-items: center; }
  .photo-slot {
    aspect-ratio: 4 / 5; border-radius: 16px; border: 1px dashed var(--ice-line);
    background: var(--ice); display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 24px; font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; letter-spacing: .04em; color: var(--steel); line-height: 1.6;
  }
  .founder-text h2 { font-size: clamp(27px, 3.7vw, 37px); color: var(--navy); margin: 12px 0 22px; }
  .founder-text p { color: var(--text-mid); font-size: 17.5px; line-height: 1.72; margin-bottom: 18px; }
  .founder-text p strong { color: var(--navy); font-weight: 600; }
  @media (max-width: 780px) { .founder-grid { grid-template-columns: 1fr; gap: 32px; } .photo-slot { max-width: 320px; margin: 0 auto; } }

  /* CTA */
  .cta { background: var(--navy-deep); color: #fff; padding: 92px 0; }
  .cta-in { text-align: center; max-width: 560px; margin: 0 auto; padding: 0 32px; }
  .cta h2 { font-size: clamp(28px, 4vw, 40px); margin: 14px 0 30px; }
</style>
