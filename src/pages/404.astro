---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." lang="en">
  <section class="nf">
    <div class="nf-wrap">
      <div class="eyebrow" style="color:var(--sky)">Error 404</div>
      <h1 class="serif">This route doesn't exist.</h1>
      <p>The page you were looking for may have moved or never existed. Let's get you back on track.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/enquire/" class="btn-quiet">Get in touch →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { background: var(--navy-deep); color: #fff; padding: 120px 0; min-height: 60vh; display: flex; align-items: center; }
  .nf-wrap { max-width: 640px; margin: 0 auto; padding: 0 32px; text-align: center; }
  .nf h1 { color: #fff; margin: 14px 0 16px; font-size: clamp(30px, 5vw, 46px); line-height: 1.1; }
  .nf p { color: #c8d6e5; font-size: 17px; line-height: 1.7; margin-bottom: 32px; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: center; }
  .nf .btn-quiet { color: var(--sky-bright); border-bottom-color: rgba(127,176,217,.4); }
  .nf .btn-quiet:hover { color: #fff; border-color: #fff; }
</style>
