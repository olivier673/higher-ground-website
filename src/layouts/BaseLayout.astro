---
// Shared layout for every page, in both languages.
// The design system (fonts, palette, nav, footer) lives here once —
// individual pages only supply a title and their own content.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
}

const { title, description = '', lang = 'en' } = Astro.props;

const nav = {
  en: {
    performanceLab: 'Performance Lab',
    leadership: 'Leadership',
    agencies: 'Agencies',
    journal: 'Journal',
    about: 'About',
    enquire: 'Enquire',
  },
  fr: {
    performanceLab: 'Performance Lab',
    leadership: 'Leadership',
    agencies: 'Agences',
    journal: 'Journal',
    about: 'À propos',
    enquire: 'Contact',
  },
};

const t = nav[lang];
const prefix = lang === 'fr' ? '/fr' : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Higher Ground</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="nav">
      <div class="nav-in">
        <a href={prefix || '/'} class="logo">Higher<span>·</span>Ground</a>
        <div class="nav-links">
          <a href={`${prefix}/performance-lab`}>{t.performanceLab}</a>
          <a href={`${prefix}/leadership`}>{t.leadership}</a>
          <a href={`${prefix}/agencies`}>{t.agencies}</a>
          <a href={`${prefix}/journal`}>{t.journal}</a>
          <a href={`${prefix}/about`}>{t.about}</a>
          <a href={`${prefix}/enquire`} class="nav-cta">{t.enquire}</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <span>© 2026 Higher Ground</span>
        <span>{lang === 'fr' ? 'Barcelone' : 'Barcelona'}</span>
      </div>
    </footer>
  </body>
</html>
